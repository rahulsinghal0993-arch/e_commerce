# Absolute URL of the Express API — Next.js has no dev proxy, so this is set
# in every environment (unlike the Vite apps, which default to a proxy path).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google sign-in (optional). Leave unset to hide the "Continue with Google"
# button. The anon key is public by design and only lets the browser run the
# user's own OAuth login. Enable the Google provider in Supabase
# (Auth -> Providers), then add this app's /auth/callback URL to the
# redirect allowlist.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
