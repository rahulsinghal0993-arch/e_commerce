# ---- Server ----
PORT=4000
# Where the client apps run (used for CORS), comma-separated — there are
# three now: the Next.js customer storefront, and the seller/admin Vite SPAs.
CLIENT_ORIGINS=http://localhost:3000,http://localhost:5174,http://localhost:5175
# Older single-origin form, still read as a fallback if CLIENT_ORIGINS is unset.
# CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# ---- Session cookies ----
# 'lax' works when the SPA and API share a site (including the Vite proxy).
# Use 'none' only if the API is on a different site than the SPA; that also
# requires HTTPS (Secure), i.e. production.
COOKIE_SAMESITE=lax
# Optional: restrict cookies to a parent domain, e.g. .example.com
# COOKIE_DOMAIN=

# ---- Supabase ----
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# "anon public" key. Safe-ish (RLS-gated); used here only for auth sign-in / refresh.
SUPABASE_ANON_KEY=your-anon-public-key

# "service_role" key. FULL ACCESS, bypasses RLS. SERVER ONLY.
# Never put this in the React app, a VITE_ variable, or version control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---- Razorpay (optional) ----
# Leave unset to boot without payments; /payments routes then answer 503.
# Dashboard -> Account & Settings -> API Keys. Only KEY_ID reaches the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks (event: payment.captured / payment.failed). Signs the
# raw request body. SERVER ONLY.
RAZORPAY_WEBHOOK_SECRET=
